[node name="Text" type="Label" parent="HelpPanel"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.45, 1, 0.55, 0.9)
theme_override_font_sizes/font_size = 14
text = "W / S — газ (с остановкой на нуле)
X — полный стоп
A / D — поворот ног
Мышь — поворот и наклон торса
C — выровнять торс по ногам
Ctrl (держать) — осмотреться, орудия на месте
Z или колесо мыши — приближение
E — ближайшая цель, T — следующая, Q — под прицелом
ЛКМ — группа 1,  ПКМ — группа 2,  СКМ / R — группа 3
Пробел — прыжок (в воздухе: вверх),  Shift — вниз
M — режим радара,  F — сесть в броню / выйти
V — кабина / внешний вид
Esc — пауза и меню,  F1 — скрыть справку"
