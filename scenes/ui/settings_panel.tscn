[node name="Note" type="Label" parent="Tabs/Graphics/Rows"]
layout_mode = 2
text = "Дальность прорисовки мелочей (уличная мебель, машины, оборудование домов, растения) сильнее всего влияет на частоту кадров и применяется с началом следующего боя. Размер окна действует в оконном режиме; на весь экран картинка рисуется в разрешении экрана, а нагрузку снижает «Разрешение 3D-картинки»."
autowrap_mode = 3
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.6, 0.63, 0.68, 1)

