[layer_names]

3d_render/layer_10="Target preview"
3d_physics/layer_1="World"
3d_physics/layer_2="Player body"
3d_physics/layer_3="Enemy body"
3d_physics/layer_4="Player hit boxes"
3d_physics/layer_5="Enemy hit boxes"
3d_physics/layer_6="Props (stop shots and infantry)"
3d_physics/layer_7="Wrecks"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=4
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
anti_aliasing/quality/screen_space_aa=2
