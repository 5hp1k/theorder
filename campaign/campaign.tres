[resource]
script = ExtResource("6_ud88y")
Title = "Пример кампании"
Description = "Это пример: две миссии, на которых видно всё, из чего строится сюжет — брифинг, катсцены, радио, цели, триггеры, подкрепления, звено и награды. Замените их своими."
Hero = ExtResource("1_3mbot")
Missions = [ExtResource("2_twoj5"), ExtResource("3_bmqgl")]
StartUnits = PackedStringArray("hound", "cleaver")
StartWeapons = PackedStringArray("small_laser", "medium_laser", "machine_gun", "srm")
StartPilots = [ExtResource("4_fqnjj"), ExtResource("5_lj2ic")]
