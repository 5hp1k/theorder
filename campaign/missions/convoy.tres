[resource]
script = ExtResource("4_krq2n")
Id = "convoy"
Title = "Конвой"
Location = "Пустыня, дорога на перевал, полдень"
Briefing = "Колонна бронетранспортёров с ранеными идёт к перевалу. Налётчики не оставят её в покое. Прикройте колонну, пока не подойдёт эвакуация. Вожак налётчиков, Клык, может быть среди нападающих."
Objectives = PackedStringArray("Продержаться до прихода эвакуации", "Сохранить колонну (можно потерять одну машину)", "Дополнительно: уничтожить всех нападающих")
Scene = "res://campaign/missions/convoy.tscn"
TimeOfDay = 2
Lance = [SubResource("Resource_ulpau"), SubResource("Resource_p5g2f")]
GrantUnits = PackedStringArray("executioner")
GrantWeapons = PackedStringArray("ppc")
Debriefing = "Колонна дошла до перевала. Звену передан тяжёлый «Палач» и протонная пушка."
